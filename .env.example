POSTGRES_DB=postgres
POSTGRES_USER=cashflow
POSTGRES_PASSWORD=cashflow
APP_PASSWORD=cashflow

ENTRIES_POSTGRES_HOST=postgres-entries
ENTRIES_POSTGRES_PORT=25432
ENTRIES_DB_DEFAULT=Host=${ENTRIES_POSTGRES_HOST};Database=entries;Username=entries_app;Password=${APP_PASSWORD};Maximum Pool Size=20
ENTRIES_DB_MIGRATIONS=Host=${ENTRIES_POSTGRES_HOST};Database=entries;Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD};Maximum Pool Size=5
ENTRIES_DB_PUBLISHER=Host=${ENTRIES_POSTGRES_HOST};Database=entries;Username=entries_publisher;Password=${APP_PASSWORD};Maximum Pool Size=5

BALANCE_POSTGRES_HOST=postgres-balance
BALANCE_POSTGRES_PORT=25433
BALANCE_DB_DEFAULT=Host=${BALANCE_POSTGRES_HOST};Database=balance;Username=balance_app;Password=${APP_PASSWORD};Maximum Pool Size=20
BALANCE_DB_MIGRATIONS=Host=${BALANCE_POSTGRES_HOST};Database=balance;Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD};Maximum Pool Size=5
BALANCE_DB_CONSUMER=Host=${BALANCE_POSTGRES_HOST};Database=balance;Username=balance_consumer;Password=${APP_PASSWORD};Maximum Pool Size=5

RABBITMQ_USER=cashflow
RABBITMQ_PASSWORD=cashflow
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=25672
RABBITMQ_UI_PORT=25673
ENTRIES_RABBITMQ_USER=entries
ENTRIES_RABBITMQ_PASSWORD=entries
BALANCE_RABBITMQ_USER=balance
BALANCE_RABBITMQ_PASSWORD=balance

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=28080
KEYCLOAK_PUBLIC_URL=http://localhost:28080
KEYCLOAK_REALM=cashflow
KEYCLOAK_WEB_CLIENT_ID=cashflow-web
KEYCLOAK_AUTHORITY=http://keycloak:8080/realms/cashflow

ENTRIES_PORT=25001
ENTRIES_AUDIENCE=cashflow-entries
BALANCE_PORT=25002
BALANCE_AUDIENCE=cashflow-balance
ENTRIES_PUBLIC_URL=http://localhost:${ENTRIES_PORT}
BALANCE_PUBLIC_URL=http://localhost:${BALANCE_PORT}
CORS_ORIGINS=http://localhost:24200,http://localhost:4200
ASPNETCORE_ENVIRONMENT=Development

ASPIRE_PORT=28888
OTEL_ENDPOINT=http://aspire-dashboard:18889

WEB_PORT=24200 

